// Raspberry Pi 4B 16-bit SMI write link (HDMI build).
// Pin assignments follow the project wiring table. BUSY uses the formerly
// spare FPGA pin 76; connect it to an unused Pi GPIO such as GPIO26.
IO_LOC  "smi_swe_n" 77;
IO_PORT "smi_swe_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "smi_a0" 75;
IO_PORT "smi_a0" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "smi_data[0]" 73;
IO_LOC  "smi_data[1]" 74;
IO_LOC  "smi_data[2]" 27;
IO_LOC  "smi_data[3]" 28;
IO_LOC  "smi_data[4]" 26;
IO_LOC  "smi_data[5]" 25;
IO_LOC  "smi_data[6]" 29;
IO_LOC  "smi_data[7]" 30;
IO_LOC  "smi_data[8]" 31;
IO_LOC  "smi_data[9]" 42;
IO_LOC  "smi_data[10]" 41;
IO_LOC  "smi_data[11]" 48;
IO_LOC  "smi_data[12]" 49;
IO_LOC  "smi_data[13]" 86;
IO_LOC  "smi_data[14]" 72;
IO_LOC  "smi_data[15]" 71;

IO_PORT "smi_data[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "smi_data[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "smi_data[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "smi_data[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "smi_data[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "smi_data[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "smi_data[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "smi_data[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "smi_data[8]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "smi_data[9]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "smi_data[10]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "smi_data[11]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "smi_data[12]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "smi_data[13]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "smi_data[14]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "smi_data[15]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC  "gpu_busy" 76;
IO_PORT "gpu_busy" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
